# ── Conversion tracking ─────────────────────────────────────────────────────
# Every value below is OPTIONAL. Leave one blank and that platform is never
# loaded — the site ships fully functional with none of them set, which is how
# it runs today. Fill them in when the ad accounts exist.
#
# Nothing here is a secret: measurement IDs are public by design and visible in
# any browser's network tab. They live in env only so the same build can run
# against a test property.

# GA4 measurement ID — Google Analytics > Admin > Data streams
VITE_GA4_ID=

# Google Ads conversion ID — Google Ads > Goals > Conversions > Google tag
VITE_GOOGLE_ADS_ID=

# Google Ads conversion labels, one per action. Copy the full `AW-XXXX/label`
# string from the conversion action's tag setup.
VITE_ADS_LABEL_DEMO=
VITE_ADS_LABEL_INQUIRY=
VITE_ADS_LABEL_HOST_SIGNUP=

# Meta pixel ID — Meta Events Manager > Data sources
# Loaded ONLY after a marketing consent grant: Meta has no Consent Mode
# equivalent, so there is no compliant way to load it earlier in the EEA.
VITE_META_PIXEL_ID=
